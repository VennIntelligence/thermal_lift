{
  "_comment": "Realistic 2x training pool (v5). IDENTICAL to v4 (defects + isothermal + field noise) EXCEPT the GT edge sharpness: temperature_isothermal.edge_sigma 1.4 -> 0.8. ACL-030 diagnosis: at edge_sigma=1.4 the GT itself carried ~zero super-resolution-band energy (out_of_band(GT)=0.00008, matching the trained model's real-data output 0.00001) -> the model faithfully reproduced a detail-free target = 'blurry, no detail'. The blur was in the TARGET, not the loss. edge_sigma=0.8 puts edges at ~1 pitch (20um = 2 HR px = the recoverable limit), ~40x more SR-band detail to learn, WITHOUT demanding sub-pitch detail (that would re-invite the FM-1 beading of the old aggressive runs; do NOT go below ~0.6). Realism/blur belongs in the forward/observation path (PSF), sharpness belongs in the GT. seed kept = v4 for a controlled A/B (same geometry/draws, only GT sharpness differs).",
  "dataset": "ThermalChipPhantom_v5_sharp",
  "engine": "TCForge",
  "version": "0.5.0",
  "scale": 2,
  "lr_shape": [480, 640],
  "hr_shape": [960, 1280],
  "pixel_size_um": 20.0,
  "spatial_resolution_um": 20.0,
  "forward_mode": "physical_block_average",
  "num_scenes": 5000,
  "seed": 940940,
  "output_dir": "data/synthetic/pool_2x_v5_5k",

  "n_frames_per_scene": {"dist": "randint", "low": 24, "high": 96},

  "geometry": {
    "antialias": true,
    "ssaa_factor": 4,
    "ssaa_factor_fine": 6,
    "inscribe_disc": true
  },

  "defects": {
    "enabled": true,
    "severity_range": [0.3, 1.0],
    "hole_radius_px": [4, 13],
    "notch_radius_px": [3, 10],
    "crack_len_px": [60, 260],
    "crack_width_px": [2, 4],
    "max_holes": 6,
    "max_notches": 6,
    "max_cracks": 4
  },

  "temperature_model": "isothermal",
  "temperature_isothermal": {"level_min": 0.82, "edge_sigma": 0.8},

  "physics_ranges": {
    "psf_sigma_lr_px": [0.15, 0.55],
    "noise_sigma_c": {"dist": "lognormal", "mean": 0.0724, "sigma_factor": 0.25},
    "T_bg_c": [19.0, 23.0],
    "delta_T_c_by_difficulty": {
      "easy": [2.0, 5.0],
      "medium": [1.0, 3.0],
      "hard": [0.5, 2.0],
      "stress": [0.3, 0.8]
    },
    "low_freq_amplitude_c": [0.0, 0.15],
    "low_freq_sigma_px": 96.0,
    "rotation_deg_center": {"dist": "uniform", "low": 0.0, "high": 360.0},
    "rotation_jitter_deg": 0.0
  },

  "difficulty_distribution": {"easy": 150, "medium": 400, "hard": 350, "stress": 100},
  "drift_distribution": {"none": 300, "scalar_offset": 250, "lowfreq": 200, "gain_offset": 100, "temporal_trend": 150},
  "drift_parameters": {
    "amplitude_c": [0.0, 0.3], "lowfreq_sigma_px": 96.0, "gain_sigma": 0.01,
    "offset_sigma_c": 0.1, "temporal_spatial_sigma_px": [0.0, 24.0]
  },

  "psf_randomization": {
    "enabled": true, "sigma_range": [0.15, 0.55],
    "elliptical_probability": 0.50, "airy_probability": 0.15, "angle_random": true
  },

  "shift_constellation": {
    "mode": "random_phase",
    "phase_steps_choices": [2, 3, 4],
    "coverage_quality_weights": {"good": 0.5, "medium": 0.3, "poor": 0.2},
    "jitter_std_px": [0.0, 0.08],
    "include_real_like_fraction": 0.15
  },

  "noise_model": {
    "model": "field_vignette_stripe",
    "vignette_c": [0.10, 0.16],
    "stripe_c": [0.020, 0.035],
    "stripe_col_sigma": [2.5, 5.0],
    "grain_c": [0.08, 0.12]
  },
  "detector_defects": {"enabled": false, "_note": "disabled: real frames (min 18.67C) show no dead-pixel spikes; was injecting unrealistic <0C cold pixels", "defect_rate": [0.0, 0.0005], "mode": "offset", "hot_delta_c": [0.2, 0.8], "cold_delta_c": [-0.8, -0.2]},

  "features": {
    "drizzle_2x": true,
    "phase_bin_drizzle": {"enabled": true, "n_bins": 4},
    "fused_1x_stats": true,
    "drizzle_variants_k": 4
  },

  "storage": {
    "format": "compact",
    "obs_features_resolution": "1x",
    "obs_features_dtype": "float16",
    "compress_features": true,
    "save_lr_burst": true,
    "burst_dtype": "float16",
    "compress_burst": false,
    "save_hr_temperature": true
  },
  "obs_features_channels": ["aligned_mean", "aligned_median", "coverage", "variance", "highpass_fused"]
}
