    "vignette_c": [0.10, 0.16],
    "stripe_c": [0.05, 0.08],
    "stripe_col_sigma": [2.5, 4.5],
    "row_stripe_c": [0.035, 0.06],
    "stripe_row_sigma": [4.5, 6.5],
    "lowfreq_c": [0.04, 0.10],
    "lowfreq_alpha": [1.7, 1.8],
    "pixel_fpn_c": [0.05, 0.09],
    "grain_c": [0.08, 0.12],
    "grain_ar1_rho": [0.5, 0.7]
