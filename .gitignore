# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/

# ===== UV / Venv =====
.venv/
algos/*/.venv/
tcforge/.venv/

# ===== macOS =====
.DS_Store
._*
.Spotlight-V100
.Trashes

# ===== 数据（太大，手动拷贝到新机器） =====
data/

# ===== 生成产物（由 notebook 执行重建） =====
output/
outputs/
algos/*/outputs/
*.zip

# Root-level reports are legacy/generated scratch. Formal reports live in paper/reports/.
# (Anchored to root: an unanchored "reports/" would also ignore new files under paper/reports/.)
/reports/

# Remote agent handoff inbox is local-only; promote durable findings into tracked logs/reports.
remote_inbox/

# ===== 临时工作区 / 草稿（不入 Git） =====
tmp/
todos/
**/Untitled

# ===== 训练权重 / 测试缓存 =====
checkpoints/
*.pt
*.pth
.pytest_cache/

# ===== Notebook 构建产物（从 fragments/ 重建） =====
# fragments/*.py 是源码，会被 track
# .ipynb 是构建产物，由 build_notebook.py 生成
notebooks/**/*.ipynb

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== IDE =====
.vscode/
.idea/
